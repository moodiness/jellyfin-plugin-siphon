<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Siphon</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Siphon</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.4.1.0</Version>
    <RepositoryUrl>https://github.com/moodiness/jellyfin-plugin-siphon</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Common" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Data" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Jellyfin.Plugin.Siphon.Tests" />
    <EmbeddedResource Include="Web\siphon.html" />
    <EmbeddedResource Include="Web\siphon-user.html" />
    <EmbeddedResource Include="..\..\assets\siphon.png" LogicalName="Jellyfin.Plugin.Siphon.Assets.siphon.png" />
    <Content Include="..\..\assets\siphon.png" Link="siphon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
