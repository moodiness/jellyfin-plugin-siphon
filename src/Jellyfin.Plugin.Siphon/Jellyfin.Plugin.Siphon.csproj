<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Siphon</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.Siphon</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Version>1.6.4.0</Version>
    <RepositoryUrl>https://github.com/moodiness/jellyfin-plugin-siphon</RepositoryUrl>
    <PythonExe Condition="'$(PythonExe)' == '' and '$(OS)' == 'Windows_NT'">python</PythonExe>
    <PythonExe Condition="'$(PythonExe)' == ''">python3</PythonExe>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Common" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Data" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="Jellyfin.Plugin.Siphon.Tests" />
    <EmbeddedResource Include="Web\siphon.html" />
    <EmbeddedResource Include="Web\siphon-user.html" />
    <EmbeddedResource Include="Web\*.js" />
    <EmbeddedResource Include="..\..\manifest.json" LogicalName="Jellyfin.Plugin.Siphon.RepositoryManifest.json" />
    <EmbeddedResource Include="..\..\assets\siphon.png" LogicalName="Jellyfin.Plugin.Siphon.Assets.siphon.png" />
    <Content Include="..\..\assets\siphon.png" Link="siphon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GenerateSiphonBuildProvenance" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(MSBuildProjectDirectory)/../../scripts/package.py&quot; --write-build-provenance &quot;$(IntermediateOutputPath)SiphonBuildProvenance.g.cs&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)SiphonBuildProvenance.g.cs" />
    </ItemGroup>
  </Target>
</Project>
